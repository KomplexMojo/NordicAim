{
  "name": "advanced-shooting-analysis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:test": "VITE_FAKE_CAMERA=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts",
    "test:e2e:offline": "playwright test -c playwright.offline.config.ts",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:privacy",
    "render:samples": "tsx scripts/render-samples.ts",
    "make:icons": "tsx scripts/make-icons.ts",
    "cv:eval": "tsx --tsconfig tsconfig.test.json scripts/cv-eval.ts",
    "review:detection": "tsx --tsconfig tsconfig.test.json scripts/detection-review/build.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@techstark/opencv-js": "5.0.0-release.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "comlink": "4.4.2",
    "exifr": "7.1.3",
    "idb": "8.0.3",
    "lucide-react": "1.46.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.3.1",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "exif-reader": "2.0.3",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "shadcn": "4.21.0",
    "sharp": "0.35.4",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1"
  }
}
